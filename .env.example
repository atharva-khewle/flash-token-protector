# Server-side only. Never prefix these with VITE_ (that would put them in the bundle).

# Optional: Etherscan V2 key. Enables "all token transfers" in the wallet scan,
# which is how fake USDT sent to you shows up. Free tier covers Ethereum;
# BSC needs a paid Etherscan plan (checked Oct 2026, verify on etherscan.io/apis).
EXPLORER_API_KEY=

# Optional: comma-separated allowed origins for the proxy (defaults to same-origin only).
ALLOWED_ORIGINS=
